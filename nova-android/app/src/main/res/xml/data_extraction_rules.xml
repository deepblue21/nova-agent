<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) kuralları. Bulut yedeği ve cihazdan cihaza aktarım
  ayrı ayrı tanımlanır; bu dosya yoksa ikisi de "her şeyi al" varsayılanında
  kalıyordu (bkz. backup_rules.xml'deki gerekçe).

  Erişim belirteçleri buluta veya yeni cihaza aktarılmaz; yeniden eşleme gerekir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="datastore/nova_settings.preferences_pb" />
        <exclude domain="sharedpref" path="nova_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Modeller yeniden indirilebilir; aktarımı gereksiz yere yavaşlatır. -->
        <exclude domain="file" path="models" />
        <exclude domain="file" path="datastore/nova_settings.preferences_pb" />
        <exclude domain="sharedpref" path="nova_settings.xml" />
    </device-transfer>
</data-extraction-rules>
