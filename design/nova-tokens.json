  "schemes": {
    "note": "Yüzey şeması. `dark` varsayılandır ve token'ların ana `color` bloğunu kullanır. `light` saf beyaz DEĞİL, sıcak kırık beyaz (kağıt): marka işaretinin sıcak çekirdeği saf beyazda kaybolduğu için. Açık şemada yüzeyler beyaz-alfa yerine siyah-alfa olur, aurora blob'ları `screen` yerine `multiply` ile çizilir.",
    "default": "dark",
    "light": {
      "id": "light",
      "name": "Kağıt",
      "color": {
        "bg": "#F6F3EC",
        "bg2": "#FFFFFF",
        "bg3": "#EDE9E0",
        "surface1": { "hex": "#131722", "alpha": 0.045 },
        "surface2": { "hex": "#131722", "alpha": 0.075 },
        "line": { "hex": "#131722", "alpha": 0.13 },
        "panel": { "hex": "#FFFFFF", "alpha": 0.82 },
        "blurTint": { "hex": "#FFFFFF", "alpha": 0.72 },
        "scrim": { "hex": "#2A2620", "alpha": 0.42 },
        "textMain": "#171A24",
        "muted": "#5A6274",
        "muted2": "#8A93A6"
      },
      "aurora": { "blend": "multiply", "opacity": 0.20, "blur": 96 },
      "aperture": {
        "note": "Açık zeminde beyaz çekirdek kaybolur: çekirdek koyulaşır, kontur güçlenir, halo noktaları nötr griye döner.",
        "coreHighlight": "mid",
        "strokeAlpha": 0.58,
        "haloDot": "#6B7488"
      }
    }
  },

  "brand": {
    "note": "NOVA Pulse Aperture — tek marka işareti. Web `ui/NovaMark.jsx` ile Android `ui/brand/NovaThinkingIndicator.kt` aynı geometriyi ve aynı zamanlamayı kullanır. Renkler sabit değildir: aktif aksanın `aperture` seti uygulanır.",
    "aperture": {
      "viewport": 560,
      "originX": 280,
      "originY": 282,
      "componentSize": 44,
      "haloDiameter": 36,
      "haloDotCount": 14,
      "markRestSize": 18,
      "markPeakSize": 23,
      "coreX": 280,
      "coreY": 286,
      "coreGlowRadius": 58,
      "coreRadius": 22,
      "highlightX": 273,
      "highlightY": 278,
      "highlightRadius": 6.5,
      "strokeAlpha": 0.42,
      "motion": {
        "breathMs": 2750,
        "corePulseMs": 1375,
        "orbitMs": 4200,
        "shimmerMs": 5500,
        "microTiltDeg": 0.7,
        "easing": "cubic-bezier(0.45, 0, 0.25, 1)"
      },
      "bodyPath": "M280,128 C319,128 319,205 354,226 C381,242 429,244 437,277 C445,311 390,323 361,342 C327,365 319,433 280,436 C241,433 233,365 199,342 C170,323 115,311 123,277 C131,244 179,242 206,226 C241,205 241,128 280,128Z",
      "foldPath": "M250,130 C285,178 324,198 316,239 C309,277 250,282 246,324 C243,359 286,386 294,434 C261,420 248,379 219,354 C188,327 153,319 126,297 C164,285 203,267 225,238 C249,207 242,165 250,130Z",
      "bodyGradient": { "startX": 138, "startY": 128, "endX": 420, "endY": 428 },
      "foldGradient": { "startX": 174, "startY": 132, "endX": 332, "endY": 420 }
    }
  },

  "radius": { "xs": 8, "sm": 10, "md": 13, "lg": 16, "xl": 20, "xxl": 26, "pill": 999 },

  "space": { "xxs": 4, "xs": 6, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 26, "xxxl": 32 },

  "motion": {
    "duration": {
      "instant": 120,
      "fast": 180,
      "base": 240,
      "slow": 420,
      "reveal": 620,
      "orbCycle": 9000,
      "auroraDrift": 28000
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.7, 0.3, 1)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "orb": {
      "blobCount": 5,
      "particleCount": 54,
      "coreRadiusRatio": 0.55,
      "ringRadiusRatio": 1.16,
      "levelGain": 0.22,
      "desc": "Web canvas orb'u ile Compose Orb.kt aynı formülü kullanır."
    }
  },

  "typography": {
    "display": { "web": "Syne", "android": "FontWeight.Black", "desc": "marka + başlık" },
    "body": { "web": "Sora", "android": "default sans", "desc": "gövde" },
    "mono": { "web": "JetBrains Mono", "android": "monospace", "desc": "teknik etiket / kod" },
    "scale": { "label": 11, "caption": 12, "body": 14, "bodyLg": 15, "title": 18, "headline": 22, "display": 30 }
  },

