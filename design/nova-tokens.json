{
  "$schema": "./nova-tokens.schema.md",
  "version": 1,
  "note": "NOVA ortak tasarım kaynağı. Web (React/CSS) ve Android (Compose) buradan üretilir. Elle düzenlenecek TEK dosya burasıdır; sonra `npm run tokens` çalıştır.",

  "color": {
    "bg":       { "hex": "#0A0E1A", "desc": "uygulama zemini" },
    "bg2":      { "hex": "#0D1326", "desc": "yükseltilmiş yüzey / panel" },
    "bg3":      { "hex": "#080A11", "desc": "sol ray / en arka katman" },
    "surface1": { "hex": "#FFFFFF", "alpha": 0.05, "desc": "kart yüzeyi" },
    "surface2": { "hex": "#FFFFFF", "alpha": 0.08, "desc": "hover / basılı yüzey" },
    "panel":    { "hex": "#0D1326", "alpha": 0.78, "desc": "mat cam panel dolgusu" },
    "blurTint": { "hex": "#0A0E1A", "alpha": 0.72, "desc": "bulanık yüzey renk katmanı" },
    "scrim":    { "hex": "#000000", "alpha": 0.68, "desc": "modal arka plan perdesi" },
    "line":     { "hex": "#FFFFFF", "alpha": 0.09, "desc": "kenarlık" },
    "textMain": { "hex": "#EEF1FB", "css": "text", "desc": "ana metin (Compose'da Text composable ile çakışmasın diye TextMain)" },
    "muted":    { "hex": "#9AA3BD", "desc": "ikincil metin" },
    "muted2":   { "hex": "#5B6276", "desc": "üçüncül metin / etiket" },
    "success":  { "hex": "#53D6A6", "desc": "hazır / tamamlandı" },
    "warning":  { "hex": "#FFC857", "desc": "kontrol ediliyor / uyarı" },
    "danger":   { "hex": "#FB7185", "desc": "hata / iptal" },
    "ember":    { "hex": "#FF8A5B", "desc": "ajan & araç izi vurgusu" }
  },

