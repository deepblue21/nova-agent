    "local":     { "lucide": "Smartphone",     "material": "PhoneAndroid" },
    "gateway":   { "lucide": "Link2",          "material": "Link" },
    "cloud":     { "lucide": "Cloud",          "material": "Cloud" },
    "cpu":       { "lucide": "Cpu",            "material": "Memory" },
